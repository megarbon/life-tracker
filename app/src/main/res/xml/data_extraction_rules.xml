<?xml version="1.0" encoding="utf-8"?>
<!--
    Ni la copia en la nube ni la transferencia entre dispositivos incluyen datos de la app (privacidad primero).
    Ver backup_rules.xml.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
