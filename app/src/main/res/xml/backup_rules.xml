<?xml version="1.0" encoding="utf-8"?>
<!--
    Life Tracker guarda finanzas, notas de ánimo y hábitos de salud: no debe salir del móvil sin que el usuario lo decida.
    La copia automática está desactivada en el manifiesto (allowBackup="false"); estas reglas excluyen todo por si
    algún día se reactiva, para no subir la base de datos por descuido. La copia de seguridad prevista es un
    export/import JSON propio (ver docs/backlog/README.md).
-->
<full-backup-content>
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="." />
</full-backup-content>
